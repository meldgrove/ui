{
  "name": "@meldgrove/ui",
  "version": "0.0.0",
  "description": "The shared interface of the Meldgrove apps: theme, components and the update button.",
  "license": "Apache-2.0",
  "author": "Simon Schubert",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meldgrove/ui.git"
  },
  "homepage": "https://github.com/meldgrove/ui#readme",
  "bugs": "https://github.com/meldgrove/ui/issues",
  "keywords": [
    "meldgrove",
    "react",
    "shadcn",
    "tailwindcss",
    "components"
  ],
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": [
    "**/*.css",
    "./dist/standalone/*"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css",
    "./standalone/meldgrove-updates.js": "./dist/standalone/meldgrove-updates.js",
    "./standalone/meldgrove-secret-input.js": "./dist/standalone/meldgrove-secret-input.js",
    "./updates": {
      "types": "./dist/updates/index.d.ts",
      "default": "./dist/updates/index.js"
    },
    "./updates/core": {
      "types": "./dist/updates/core.d.ts",
      "default": "./dist/updates/core.js"
    },
    "./utils": {
      "types": "./dist/lib/utils.d.ts",
      "default": "./dist/lib/utils.js"
    },
    "./i18n": {
      "types": "./dist/lib/i18n.d.ts",
      "default": "./dist/lib/i18n.js"
    },
    "./format": {
      "types": "./dist/lib/format.d.ts",
      "default": "./dist/lib/format.js"
    },
    "./portal": {
      "types": "./dist/lib/portal.d.ts",
      "default": "./dist/lib/portal.js"
    },
    "./theme": {
      "types": "./dist/lib/theme.d.ts",
      "default": "./dist/lib/theme.js"
    },
    "./use-mobile": {
      "types": "./dist/hooks/use-mobile.d.ts",
      "default": "./dist/hooks/use-mobile.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    }
  },
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/prepare.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:visual": "playwright test",
    "test:visual:update": "node scripts/visual-update.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "dev:templates": "vite --config demo/templates/vite.config.ts",
    "build:templates": "node scripts/build-templates.mjs"
  },
  "peerDependencies": {
    "cmdk": "^1.1.0",
    "lucide-react": "^1.0.0",
    "radix-ui": "^1.4.0",
    "react": "^19.0.0",
    "react-day-picker": ">=9.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0",
    "sonner": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "cmdk": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "radix-ui": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-day-picker": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "sonner": {
      "optional": true
    }
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "cmdk": "1.1.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "lucide-react": "1.71.0",
    "prettier": "3.9.10",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
